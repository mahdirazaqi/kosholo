# ─────────────────────────────────────────────────────────────────────────────
# Production configuration. Copy to .env.production and fill in:
#   cp .env.production.example .env.production
# Every variable here is also explained in DEPLOY.md.
# ─────────────────────────────────────────────────────────────────────────────

# Domain that points (A record) to this server. Caddy gets a Let's Encrypt
# certificate for it automatically. Use "localhost" for a local test (Caddy
# then uses its own local certificate).
DOMAIN=chat.example.com

# Email for Let's Encrypt (expiry notices, account recovery).
ACME_EMAIL=admin@example.com

# ── Database (the "db" service) ──
POSTGRES_USER=kosholo
# Use a long random password, e.g.: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=kosholo
# Must match the three values above; "db" is the service name on the internal network.
DATABASE_URL=postgresql://kosholo:change-me-to-a-long-random-password@db:5432/kosholo

# ── App ──
# Signs session tokens. At least 32 characters. Generate with:
#   openssl rand -base64 48
# Changing it signs everyone out.
JWT_SECRET=
# Where uploads are stored inside the app container (the "uploads" volume is
# mounted here). Leave as is.
UPLOAD_DIR=/app/uploads
# ffmpeg/ffprobe are installed in the image; leave as is.
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Max seconds for one video/voice processing job before it's stopped.
FFMPEG_TIMEOUT_SECONDS=120
# Largest file (document) users can send, in MB (default 2048 = 2 GB). Files
# are stored as uploaded, so plan disk space accordingly (DEPLOY.md, "Managing
# disk space"). Also baked into the image for the client check: rebuild after
# changing it (scripts/deploy.sh does).
MAX_FILE_SIZE_MB=2048

# ── Map tiles for location messages ──
# Baked into the image at build time (rebuild after changing). Don't use the
# public OpenStreetMap tiles in production (their usage policy forbids heavy
# use): use a provider with your own key (DEPLOY.md, "Map tiles"), e.g.
#   NEXT_PUBLIC_MAP_TILE_URL=https://tiles.example-provider.com/{z}/{x}/{y}.png?key=YOUR_KEY
# {s} in the URL is replaced by one of NEXT_PUBLIC_MAP_SUBDOMAINS.
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_SUBDOMAINS=abc
NEXT_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
NEXT_PUBLIC_MAP_MAX_ZOOM=19

# ── Images and mirrors (for servers where Docker Hub / npm / Debian are slow
#    or blocked). Defaults are the official sources; to use a mirror, prefix the
#    image with the mirror host, e.g. NODE_IMAGE=docker.example-mirror.ir/library/node:24.11-trixie-slim
NODE_IMAGE=node:24.11-trixie-slim
POSTGRES_IMAGE=postgres:17.6
CADDY_IMAGE=caddy:2.10.2
# npm registry used during the image build, e.g. a local npm mirror URL.
NPM_REGISTRY=https://registry.npmjs.org/
# Optional Debian package mirror for installing ffmpeg in the image
# (replaces http://deb.debian.org/debian), e.g. http://mirror.example.ir/debian
APT_MIRROR=

# ── Ports Caddy publishes on the host (keep 80/443 in production) ──
HTTP_PORT=80
HTTPS_PORT=443
