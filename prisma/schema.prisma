generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ConversationType {
  DIRECT
  GROUP
  CHANNEL // admins publish, members (subscribers) only read
}

enum MemberRole {
  ADMIN
  MEMBER
}

enum UploadKind {
  IMAGE
  VIDEO
  VOICE
  AVATAR
  FILE // any document, stored and served byte-for-byte (no processing)
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  VOICE
  SYSTEM // group events; `meta` holds the structured event (see SystemMeta)
  LOCATION // latitude/longitude (+ optional label)
  FILE // a document (Upload kind FILE)
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  // Always stored lowercase; normalized in application code.
  username     String    @unique
  name         String
  passwordHash String    @map("password_hash")
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt   DateTime? @map("last_seen_at") @db.Timestamptz

  contacts             Contact[]            @relation("ContactOwner")
  contactOf            Contact[]            @relation("ContactTarget")
  createdConversations Conversation[]
  ownedChannels        Conversation[]       @relation("ChannelOwner")
  memberships          ConversationMember[]
  messages             Message[]
  uploads              Upload[]
  uploadSessions       UploadSession[]
  messageHides         MessageHide[]

  @@map("users")
}

model Contact {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  owner   User @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  contact User @relation("ContactTarget", fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([ownerId, contactId])
  @@map("contacts")
}

model Conversation {
  id          String           @id @default(uuid()) @db.Uuid
  type        ConversationType
  title       String?
  avatarUrl   String?          @map("avatar_url")
  // DIRECT only: both user ids sorted and joined with ":". Null for groups.
  // The unique index guarantees one direct conversation per pair.
  directKey   String?          @unique @map("direct_key")
  // GROUP / CHANNEL: optional description (≤255, validated in application code).
  description String?          @db.VarChar(255)
  // CHANNEL only: secret invite token (admins see it; reset replaces it).
  inviteToken String?          @unique @map("invite_token")
  // CHANNEL only: posts show the posting admin's display name.
  signMessages Boolean         @default(false) @map("sign_messages")
  // CHANNEL only: the single owner (the creator, transferable).
  ownerId     String?          @map("owner_id") @db.Uuid
  createdById String           @map("created_by_id") @db.Uuid
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  createdBy User                 @relation(fields: [createdById], references: [id])
  owner     User?                @relation("ChannelOwner", fields: [ownerId], references: [id])
  members   ConversationMember[]
  messages  Message[]

  @@map("conversations")
}

model ConversationMember {
  conversationId String     @map("conversation_id") @db.Uuid
  userId         String     @map("user_id") @db.Uuid
  role           MemberRole @default(MEMBER)
  joinedAt       DateTime   @default(now()) @map("joined_at") @db.Timestamptz
  lastReadAt     DateTime?  @map("last_read_at") @db.Timestamptz
  // "Cleared history for me": messages created at or before this are
  // invisible to this member (see src/lib/chat/visibility.ts).
  clearedAt      DateTime?  @map("cleared_at") @db.Timestamptz
  // Muted conversations: no sound, not in the unread badge totals.
  muted          Boolean    @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
  @@map("conversation_members")
}

model Message {
  id             String      @id @default(uuid()) @db.Uuid
  conversationId String      @map("conversation_id") @db.Uuid
  senderId       String      @map("sender_id") @db.Uuid
  type           MessageType @default(TEXT)
  content        String?     @db.Text
  replyToId      String?     @map("reply_to_id") @db.Uuid
  // Set when the quoted message was hard-deleted (replyToId is then nulled by
  // the FK), so the quote still renders as "Message unavailable".
  replyToDeleted Boolean     @default(false) @map("reply_to_deleted")
  // IMAGE / VIDEO / VOICE messages point at their processed file.
  uploadId       String?     @unique @map("upload_id") @db.Uuid
  meta           Json?
  // LOCATION only (6 decimals, validated in sendMessageSchema).
  latitude       Float?
  longitude      Float?
  locationLabel  String?     @map("location_label") @db.VarChar(200)
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  // Time of the last edit (null = never edited). Edits overwrite `content` in
  // place; no history is kept.
  editedAt       DateTime?   @map("edited_at") @db.Timestamptz

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User          @relation(fields: [senderId], references: [id])
  replyTo      Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  upload       Upload?       @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  replies      Message[]     @relation("MessageReplies")
  hides        MessageHide[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

// "Delete for me": the message is invisible to this user only. When no current
// member can see a message any more, the message row itself is hard-deleted.
model MessageHide {
  userId    String   @map("user_id") @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([userId, messageId])
  @@index([messageId])
  @@map("message_hides")
}

// A processed file on disk under UPLOAD_DIR (never served statically; see
// /api/media/[uploadId]). Unattached uploads are cleaned up after 24h.
model Upload {
  id           String     @id @default(uuid()) @db.Uuid
  ownerId      String     @map("owner_id") @db.Uuid
  kind         UploadKind
  path         String // relative to UPLOAD_DIR: yyyy/mm/{uuid}.{ext} (FILE: yyyy/mm/{uuid}, no extension)
  thumbPath    String?    @map("thumb_path")
  // FILE only: the sanitized original name (never used on disk).
  originalName String?    @map("original_name")
  mime         String
  size         BigInt
  width        Int?
  height       Int?
  duration     Float? // seconds (video/voice)
  placeholder  String?    @db.Text // tiny blurred image as a data URL
  waveform     Json? // voice: ~48 numbers 0–1
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  message Message?

  @@index([createdAt])
  @@map("uploads")
}

// A resumable FILE upload in progress (POST /api/upload/files). Chunks are
// appended to `tempPath` (relative to UPLOAD_DIR) until receivedSize equals
// totalSize; `complete` turns it into an Upload. Abandoned sessions (not
// updated for 24h) are removed by the hourly cleanup with their temp file.
model UploadSession {
  id           String   @id @default(uuid()) @db.Uuid
  ownerId      String   @map("owner_id") @db.Uuid
  originalName String   @map("original_name")
  mime         String
  totalSize    BigInt   @map("total_size")
  receivedSize BigInt   @default(0) @map("received_size")
  tempPath     String   @map("temp_path")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([updatedAt])
  @@map("upload_sessions")
}
