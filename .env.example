# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://kosholo:kosholo@localhost:5432/kosholo"

# Secret used to sign session tokens; at least 32 characters, the server
# refuses to start otherwise (generate with: openssl rand -base64 48)
JWT_SECRET=""

# Directory where uploaded media is stored
UPLOAD_DIR="./uploads"

# Address and port the custom server listens on
HOST=0.0.0.0
PORT=3000

# ffmpeg / ffprobe binaries (system install, used for video and voice)
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# Max seconds for one video/voice ffmpeg job before it's killed
FFMPEG_TIMEOUT_SECONDS=120
