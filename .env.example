# PostgreSQL connection string (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://kosholo:kosholo@localhost:5432/kosholo"

# Secret used to sign session tokens; at least 32 characters, the server
# refuses to start otherwise (generate with: openssl rand -base64 48)
JWT_SECRET=""

# Directory where uploaded media is stored
UPLOAD_DIR="./uploads"

# Address and port the custom server listens on
HOST=0.0.0.0
PORT=3000

# ffmpeg / ffprobe binaries (system install, used for video and voice)
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"

# Max seconds for one video/voice ffmpeg job before it's killed
FFMPEG_TIMEOUT_SECONDS=120

# Largest file (document) that can be sent, in MB. Files keep their original
# bytes, so this is also the most disk space a single upload can take.
# Also used at build time for the client-side check (rebuild after changing).
MAX_FILE_SIZE_MB=2048

# Most subscribers a channel can have (default 10000). Read at runtime.
MAX_CHANNEL_MEMBERS=10000

# How long after sending a message in a chat or group can still be edited, in
# hours (default 48). Channel posts can always be edited by admins.
EDIT_WINDOW_HOURS=48

# Map tiles for location messages (Leaflet). These are read at BUILD time
# (NEXT_PUBLIC_), so rebuild after changing them. The OpenStreetMap defaults
# are for development only: OSM's public tile servers don't allow heavy use.
# In production use a provider with your own API key (see DEPLOY.md).
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
NEXT_PUBLIC_MAP_SUBDOMAINS="abc"
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap contributors"
NEXT_PUBLIC_MAP_MAX_ZOOM=19
